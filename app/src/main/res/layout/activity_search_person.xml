<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/matrix_black"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Identity search"
                android:textAppearance="@style/Identica.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Select a scan type and provide a portrait or fingerprint to search the registry."
                android:textAppearance="@style/Identica.Body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="SCAN PREVIEW"
                android:textAppearance="@style/Identica.Section" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_neon_panel">

                <ImageView
                    android:id="@+id/probePreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Identity scan target"
                    android:scaleType="centerCrop" />

                <com.example.identica.ui.scanner.FingerprintScanView
                    android:id="@+id/fingerprintScanView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <com.example.identica.ui.scanner.ScannerOverlayView
                    android:id="@+id/scannerOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <TextView
                android:id="@+id/probeLabelText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="NO SCAN TARGET"
                android:textAppearance="@style/Identica.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/captureProbeButton"
                style="@style/Identica.Button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:text="Scan face" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/uploadProbeButton"
                style="@style/Identica.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:text="Upload scan file" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startScanButton"
                style="@style/Identica.Button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:enabled="false"
                android:text="Start identity search" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="STANDBY"
                android:textAppearance="@style/Identica.Section" />

            <ProgressBar
                android:id="@+id/scanProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/matrix_charcoal_light"
                android:progressTint="@color/neon_green" />

            <TextView
                android:id="@+id/matchPercentText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="0% MATCH"
                android:textAppearance="@style/Identica.Metric" />

            <ProgressBar
                android:id="@+id/matchProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/matrix_charcoal_light"
                android:progressTint="@color/neon_cyan" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/alert_red"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/resultPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_neon_panel"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/resultPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:contentDescription="Matched identity portrait"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/resultTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textAppearance="@style/Identica.Title" />

                <TextView
                    android:id="@+id/resultDetailText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/Identica.Body" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/scanTabs"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/matrix_charcoal"
        app:tabIndicatorColor="@color/neon_green"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/neon_green"
        app:tabTextColor="@color/text_secondary" />
</LinearLayout>
