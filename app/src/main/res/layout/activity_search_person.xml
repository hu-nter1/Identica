<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/matrix_black" android:orientation="vertical">
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Identica" android:textAppearance="@style/Identica.Title"/>
<FrameLayout android:layout_width="match_parent" android:layout_height="330dp" android:layout_marginTop="14dp" android:background="@drawable/bg_neon_panel">
<ImageView android:id="@+id/probePreview" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Identity scan target" android:scaleType="centerCrop"/>
<com.example.identica.ui.scanner.FingerprintScanView android:id="@+id/fingerprintScanView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"/>
<com.example.identica.ui.scanner.ScannerOverlayView android:id="@+id/scannerOverlay" android:layout_width="match_parent" android:layout_height="match_parent"/>
</FrameLayout>
<TextView android:id="@+id/probeLabelText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="NO SCAN TARGET" android:textAppearance="@style/Identica.Body"/>
<com.google.android.material.button.MaterialButton android:id="@+id/captureProbeButton" style="@style/Identica.Button" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:text="SCAN FACE"/>
<com.google.android.material.button.MaterialButton android:id="@+id/uploadProbeButton" style="@style/Identica.Button" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:text="UPLOAD SCAN FILE"/>
<com.google.android.material.button.MaterialButton android:id="@+id/startScanButton" style="@style/Identica.Button" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:enabled="false" android:text="START IDENTITY SEARCH"/>
<TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="STANDBY" android:textAppearance="@style/Identica.Body"/>
<ProgressBar android:id="@+id/scanProgressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="6dp" android:max="100" android:progress="0" android:progressTint="@color/neon_green" android:progressBackgroundTint="@color/matrix_charcoal_light"/>
<TextView android:id="@+id/matchPercentText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="0% MATCH" android:textAppearance="@style/Identica.Metric"/>
<ProgressBar android:id="@+id/matchProgressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="4dp" android:max="100" android:progress="0" android:progressTint="@color/neon_cyan" android:progressBackgroundTint="@color/matrix_charcoal_light"/>
<TextView android:id="@+id/errorText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/alert_red" android:visibility="gone"/>
<LinearLayout android:id="@+id/resultPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_neon_panel" android:orientation="vertical" android:padding="14dp" android:visibility="gone">
<ImageView android:id="@+id/resultPhoto" android:layout_width="match_parent" android:layout_height="220dp" android:contentDescription="Matched identity portrait" android:scaleType="centerCrop"/>
<TextView android:id="@+id/resultTitleText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textAppearance="@style/Identica.Title"/>
<TextView android:id="@+id/resultDetailText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="@style/Identica.Body"/>
</LinearLayout>
</LinearLayout>
</ScrollView>
<com.google.android.material.tabs.TabLayout android:id="@+id/scanTabs" android:layout_width="match_parent" android:layout_height="58dp" android:background="@color/matrix_charcoal" app:tabIndicatorColor="@color/neon_green" app:tabMode="fixed" app:tabTextColor="@color/text_secondary" app:tabSelectedTextColor="@color/neon_green"/>
</LinearLayout>
