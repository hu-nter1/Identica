<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="ADMIN REGISTRATION"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Password: at least 4 characters. Set a 4-digit recovery code and keep it safe."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/newAdminUsername"
            style="@style/FormInput"
            android:layout_marginTop="28dp"
            android:hint="Admin username"
            android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/newAdminPassword"
                style="@style/FormInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Password"
                android:inputType="textPassword" />

            <ImageButton
                android:id="@+id/btnToggleNewPassword"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Show password"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_eye_off" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/confirmAdminPassword"
                style="@style/FormInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Confirm password"
                android:inputType="textPassword" />

            <ImageButton
                android:id="@+id/btnToggleConfirmPassword"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Show password"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_eye_off" />
        </LinearLayout>

        <EditText
            android:id="@+id/newRecoveryCode"
            style="@style/FormInput"
            android:layout_marginTop="14dp"
            android:hint="4-digit recovery code"
            android:inputType="numberPassword"
            android:maxLength="4" />

        <EditText
            android:id="@+id/confirmRecoveryCode"
            style="@style/FormInput"
            android:layout_marginTop="14dp"
            android:hint="Confirm 4-digit recovery code"
            android:inputType="numberPassword"
            android:maxLength="4" />

        <Button
            android:id="@+id/btnSaveAdmin"
            style="@style/PrimaryButton"
            android:layout_marginTop="20dp"
            android:text="Register admin" />

        <Button
            android:id="@+id/btnBackToLogin"
            style="@style/OutlineButton"
            android:layout_marginTop="12dp"
            android:text="Back" />
    </LinearLayout>
</ScrollView>
