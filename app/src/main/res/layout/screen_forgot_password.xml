<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:contentDescription="Identica logo"
        android:src="@drawable/ic_identica_mark" />

        <TextView
            style="@style/PageTitle"
            android:gravity="center"
            android:text="Reset password" />

        <TextView
            style="@style/PageSubtitle"
            android:gravity="center"
            android:text="Enter your admin username and recovery code. Passwords need 4+ characters." />

        <EditText
            android:id="@+id/recoveryUsername"
            style="@style/FormInput"
            android:layout_marginTop="24dp"
            android:hint="Admin username"
            android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/recoveryCode"
                style="@style/FormInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="4-digit recovery code"
                android:inputType="numberPassword"
                android:maxLength="4" />

            <ImageButton
                android:id="@+id/btnToggleRecoveryCode"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Show recovery code"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_eye_off" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/recoveryNewPassword"
                style="@style/FormInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="New password"
                android:inputType="textPassword" />

            <ImageButton
                android:id="@+id/btnToggleRecoveryPassword"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Show password"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_eye_off" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/recoveryConfirmPassword"
                style="@style/FormInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Confirm new password"
                android:inputType="textPassword" />

            <ImageButton
                android:id="@+id/btnToggleRecoveryConfirmPassword"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Show password"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_eye_off" />
        </LinearLayout>

        <Button
            android:id="@+id/btnResetPassword"
            style="@style/PrimaryButton"
            android:layout_marginTop="20dp"
            android:text="Set new password" />

        <Button
            android:id="@+id/btnCancelRecovery"
            style="@style/OutlineButton"
            android:layout_marginTop="12dp"
            android:text="Back to login" />
    </LinearLayout>
</ScrollView>
