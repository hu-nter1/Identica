<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Identica logo"
                android:src="@drawable/ic_identica_mark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Identica"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="LOCAL IDENTITY WORKSPACE"
                    android:textColor="@color/mint"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/homeOperator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Operator: Demo"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            style="@style/SectionTitle"
            android:layout_marginTop="32dp"
            android:text="OVERVIEW" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/OverviewCard"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/homeIdentityCount"
                    style="@style/OverviewNumber"
                    android:text="0" />

                <TextView
                    style="@style/OverviewLabel"
                    android:text="Registered identities" />
            </LinearLayout>

            <LinearLayout
                style="@style/OverviewCard"
                android:layout_marginStart="8dp">

                <TextView
                    style="@style/OverviewNumber"
                    android:text="1" />

                <TextView
                    style="@style/OverviewLabel"
                    android:text="System operators" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:text="Use the navigation below to add a profile, search the registry, or review recent activity. Your records stay on this device."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnLogout"
            style="@style/OutlineButton"
            android:layout_marginTop="32dp"
            android:text="Secure logout" />
    </LinearLayout>
</ScrollView>
